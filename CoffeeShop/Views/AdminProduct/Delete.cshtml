@model CoffeeShop.Models.Product
@{
    ViewData["Title"] = "Xác nhận xóa Sản phẩm";
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách sản phẩm
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="admin-card text-center p-4">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill fs-1"></i>
            </div>

            <h4 class="fw-bold text-dark mb-2">Xác nhận Xóa Sản phẩm</h4>
            <p class="text-muted mb-4">Bạn có chắc chắn muốn xóa sản phẩm dưới đây khỏi cửa hàng không?</p>

            <div class="card p-3 bg-light border-0 mb-4 text-start">
                <div class="d-flex align-items-center gap-3">
                    <img src="~/uploads/@Model.Image" width="75" height="75" class="rounded border object-fit-cover shadow-sm" onerror="this.src='https://cdn-icons-png.flaticon.com/512/924/924514.png'" />
                    <div>
                        <h6 class="fw-bold text-dark mb-1">@Model.ProductName</h6>
                        <div class="text-danger fw-bold fs-5">@Model.Price.ToString("N0") VNĐ</div>
                        <small class="text-muted d-block text-truncate" style="max-width: 280px;">@Model.Description</small>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2">
                <input type="hidden" asp-for="ProductId" />
                <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i> Xóa sản phẩm
                </button>
            </form>
        </div>
    </div>
</div>