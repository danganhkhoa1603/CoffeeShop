@model CoffeeShop.Models.Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách sản phẩm
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="admin-card">
            <h5 class="card-title-custom mb-4">
                <i class="bi bi-pencil-square text-warning"></i> Sửa sản phẩm #@Model.ProductId
            </h5>

            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                <input type="hidden" asp-for="ProductId" />

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="ProductName" class="form-control" placeholder="Tên sản phẩm" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select" required></select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="Price" type="number" step="1000" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Số lượng tồn kho <span class="text-danger">*</span></label>
                        <input asp-for="Stock" type="number" class="form-control" required />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                    </div>

                    <div class="col-12 mb-4">
                        <label class="form-label fw-semibold">Hình ảnh hiện tại & Thay đổi</label>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img src="~/uploads/@Model.Image" width="70" height="70" class="rounded border object-fit-cover shadow-sm" onerror="this.src='https://cdn-icons-png.flaticon.com/512/924/924514.png'" />
                            }
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                        </div>
                        <small class="text-muted">Để trống nếu không muốn đổi ảnh mới.</small>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary-coffee px-4">
                        <i class="bi bi-check-lg me-1"></i> Cập nhật sản phẩm
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>