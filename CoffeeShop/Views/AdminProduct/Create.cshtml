@model CoffeeShop.Models.Product
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách sản phẩm
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="admin-card">
            <h5 class="card-title-custom mb-4">
                <i class="bi bi-plus-circle-fill text-success"></i> Thêm sản phẩm mới
            </h5>

            <form asp-action="Create" enctype="multipart/form-data" method="post">

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="ProductName" class="form-control" placeholder="Ví dụ: Cà phê Phin Sữa Đá" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select" required></select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="Price" type="number" step="1000" class="form-control" placeholder="35000" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Số lượng tồn kho <span class="text-danger">*</span></label>
                        <input asp-for="Stock" type="number" class="form-control" placeholder="100" required />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" rows="3" class="form-control" placeholder="Mô tả ngắn gọn về hương vị, thành phần..."></textarea>
                    </div>

                    <div class="col-12 mb-4">
                        <label class="form-label fw-semibold">Hình ảnh sản phẩm</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                        <small class="text-muted">Chọn ảnh đại diện định dạng JPG, PNG, WEBP.</small>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary-coffee px-4">
                        <i class="bi bi-check-lg me-1"></i> Lưu sản phẩm
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>