@{
    ViewData["Title"] = "Đăng nhập";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="login-page">

    <div class="login-box">

        <div class="left-side">

            <img src="~/images/logo.png"
                 class="logo-image" />

            <h2>Đăng nhập Nhân viên</h2>

            <p>

                Fresh Coffee Every Day

            </p>

        </div>

        <div class="right-side">

            <div class="logo mb-4">

                Đăng nhập

            </div>

            <form method="post">

                <div class="mb-3">

                    <label>Số điện thoại</label>

                    <input type="text"
                           name="phone"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label>Mật khẩu</label>

                    <input type="password"
                           name="password"
                           class="form-control" />

                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">

                        @ViewBag.Error

                    </div>
                }

                <button class="btn-login">

                    Đăng nhập

                </button>

            </form>

            <div class="text-center mt-4">

                Chưa có tài khoản?

                <a asp-controller="Account"
                   asp-action="Register"
                   class="link">

                    Đăng ký ngay

                </a>

            </div>

        </div>

    </div>

</div>