@model CoffeeShop.Models.User

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<link rel="stylesheet" href="~/css/login.css" />
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    /* =========================
           REGISTER PAGE
        ========================= */

    .register-page {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
        background: linear-gradient(rgba(35, 22, 15, 0.82), rgba(35, 22, 15, 0.92)), url('/images/coffee-bg.jpg') center/cover no-repeat;
    }

    /* Container chính */
    .register-box {
        width: 100%;
        max-width: 1000px;
        min-height: 620px;
        display: grid;
        grid-template-columns: 42% 58%;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
    }

    /* =========================
           LEFT
        ========================= */

    .register-left {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 50px 40px;
        color: #fff;
        background: linear-gradient( rgba(60, 35, 20, 0.82), rgba(35, 20, 12, 0.92) ), url('/images/coffee-bg.jpg') center/cover no-repeat;
    }

    .register-logo {
        width: 110px;
        height: 110px;
        object-fit: contain;
        background: rgba(255,255,255,0.12);
        padding: 18px;
        border-radius: 50%;
        margin-bottom: 25px;
        border: 1px solid rgba(255,255,255,0.25);
    }

    .register-left h1 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 15px;
        letter-spacing: 0.5px;
    }

        .register-left h1 span {
            color: #d6a16b;
        }

    .register-left p {
        max-width: 320px;
        color: #eaded5;
        line-height: 1.7;
        font-size: 15px;
        margin-bottom: 30px;
    }

    .coffee-feature {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
    }

        .coffee-feature span {
            padding: 8px 14px;
            border-radius: 20px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.15);
            color: #f4e7dc;
            font-size: 13px;
        }

    /* =========================
           RIGHT
        ========================= */

    .register-right {
        padding: 50px 55px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #fff;
    }

    .register-header {
        margin-bottom: 28px;
    }

        .register-header h2 {
            color: #3b2418;
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .register-header p {
            color: #8a7b72;
            margin: 0;
            font-size: 14px;
        }

    /* =========================
           FORM
        ========================= */

    .register-form-group {
        margin-bottom: 18px;
    }

        .register-form-group label {
            display: block;
            margin-bottom: 7px;
            color: #4a3428;
            font-size: 14px;
            font-weight: 600;
        }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9b8172;
            font-size: 17px;
            z-index: 2;
        }

    .register-input {
        width: 100%;
        height: 48px;
        padding: 0 15px 0 45px;
        border: 1px solid #ddd2ca;
        border-radius: 11px;
        background: #faf9f8;
        color: #3b2418;
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .register-input::placeholder {
            color: #aaa09a;
        }

        .register-input:hover {
            border-color: #c7aa94;
        }

        .register-input:focus {
            background: #fff;
            border-color: #8b5e3c;
            box-shadow: 0 0 0 3px rgba(139, 94, 60, 0.1);
        }

        .register-input.input-error {
            border-color: #dc3545;
            background: #fff8f8;
        }

        .register-input.input-success {
            border-color: #198754;
            background: #f8fff9;
        }

    /* =========================
           ERROR
        ========================= */

    .phone-error {
        display: none;
        margin-top: 6px;
        color: #dc3545;
        font-size: 12px;
    }

    .server-error {
        padding: 10px 13px;
        margin-bottom: 15px;
        border-radius: 9px;
        background: #fff1f1;
        border: 1px solid #ffcaca;
        color: #c62828;
        font-size: 13px;
    }

    /* =========================
           BUTTON
        ========================= */

    .register-button {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 11px;
        background: #6f452c;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 5px;
    }

        .register-button:hover {
            background: #53321f;
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(83, 50, 31, 0.2);
        }

        .register-button:active {
            transform: translateY(0);
        }

    /* =========================
           LOGIN LINK
        ========================= */

    .login-link {
        text-align: center;
        margin-top: 22px;
        color: #8a7b72;
        font-size: 14px;
    }

        .login-link a {
            color: #6f452c;
            font-weight: 600;
            text-decoration: none;
        }

            .login-link a:hover {
                text-decoration: underline;
            }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 768px) {

        .register-page {
            padding: 25px 15px;
        }

        .register-box {
            grid-template-columns: 1fr;
            min-height: auto;
        }

        .register-left {
            padding: 40px 25px;
        }

        .register-logo {
            width: 80px;
            height: 80px;
        }

        .register-left h1 {
            font-size: 25px;
        }

        .register-right {
            padding: 40px 25px;
        }

        .register-header h2 {
            font-size: 26px;
        }
    }
</style>


<div class="register-page">

    <div class="register-box">

        <!-- =========================
             LEFT SIDE
        ========================== -->

        <div class="register-left">

            <img src="https://cdn-icons-png.flaticon.com/512/924/924514.png"
                 alt="Coffee House"
                 class="register-logo" />

            <h1>
                Coffee <span>Premium</span>
            </h1>

            <p>
                Đăng ký tài khoản để trải nghiệm những sản phẩm
                cà phê chất lượng và nhận nhiều ưu đãi hấp dẫn
                từ Coffee House.
            </p>

            <div class="coffee-feature">

                <span>☕ Cà phê nguyên chất</span>

                <span>🚚 Giao hàng nhanh</span>

                <span>🎁 Nhiều ưu đãi</span>

            </div>

        </div>


        <!-- =========================
             RIGHT SIDE
        ========================== -->

        <div class="register-right">

            <div class="register-header">

                <h2>Tạo tài khoản</h2>

                <p>
                    Điền thông tin bên dưới để bắt đầu sử dụng tài khoản.
                </p>

            </div>


            <form asp-action="Register"
                  method="post"
                  id="registerForm">

                <!-- HỌ TÊN -->

                <div class="register-form-group">

                    <label for="FullName">
                        Họ và tên
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-person"></i>

                        <input asp-for="FullName"
                               id="FullName"
                               class="register-input"
                               placeholder="Nhập họ và tên"
                               required />

                    </div>

                </div>


                <!-- SỐ ĐIỆN THOẠI -->

                <div class="register-form-group">

                    <label for="phone">
                        Số điện thoại
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-telephone"></i>

                        <input asp-for="Phone"
                               id="phone"
                               class="register-input"
                               placeholder="Ví dụ: 0938282070"
                               maxlength="10"
                               minlength="10"
                               pattern="^0(3|5|7|8|9)[0-9]{8}$"
                               inputmode="numeric"
                               required />

                    </div>

                    <div id="phoneError"
                         class="phone-error">

                        <i class="bi bi-exclamation-circle"></i>

                        Số điện thoại không hợp lệ.
                        Vui lòng nhập số điện thoại Việt Nam gồm 10 chữ số.

                    </div>

                </div>


                <!-- ĐỊA CHỈ -->

                <div class="register-form-group">

                    <label for="Address">
                        Địa chỉ
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-geo-alt"></i>

                        <input asp-for="Address"
                               id="Address"
                               class="register-input"
                               placeholder="Nhập địa chỉ giao hàng"
                               required />

                    </div>

                </div>


                <!-- MẬT KHẨU -->

                <div class="register-form-group">

                    <label for="Password">
                        Mật khẩu
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-lock"></i>

                        <input asp-for="Password"
                               id="Password"
                               type="password"
                               class="register-input"
                               placeholder="Tối thiểu 6 ký tự"
                               minlength="6"
                               required />

                    </div>

                </div>


                <!-- SERVER ERROR -->
                @if (ViewBag.Error != null)
                {
                    <div class="server-error">

                        <i class="bi bi-exclamation-triangle"></i>

                        @ViewBag.Error

                    </div>
                }


                <!-- BUTTON -->

                <button type="submit"
                        class="register-button">

                    <i class="bi bi-person-plus me-2"></i>

                    Đăng ký tài khoản

                </button>

            </form>


            <!-- LOGIN -->

            <div class="login-link">

                Đã có tài khoản?

                <a asp-controller="Account"
                       asp-action="Login">

                    Đăng nhập ngay

                </a>

            </div>

        </div>

    </div>

</div>


<script>

    const phone = document.getElementById("phone");
    const phoneError = document.getElementById("phoneError");
    const form = document.getElementById("registerForm");

    const phonePattern = /^0(3|5|7|8|9)[0-9]{8}$/;


    // Chỉ cho phép nhập số

    phone.addEventListener("input", function () {

        this.value = this.value.replace(/[^0-9]/g, "");

        if (this.value.length === 0) {

            phoneError.style.display = "none";

            this.classList.remove("input-error");
            this.classList.remove("input-success");

            return;
        }


        if (!phonePattern.test(this.value)) {

            phoneError.style.display = "block";

            this.classList.add("input-error");
            this.classList.remove("input-success");

        }
        else {

            phoneError.style.display = "none";

            this.classList.remove("input-error");
            this.classList.add("input-success");

        }

    });


    // Kiểm tra trước khi gửi

    form.addEventListener("submit", function (event) {

        if (!phonePattern.test(phone.value)) {

            event.preventDefault();

            phoneError.style.display = "block";

            phone.classList.add("input-error");

            phone.focus();

        }

    });

</script>