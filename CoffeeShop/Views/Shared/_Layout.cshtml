@using Microsoft.AspNetCore.Http
@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShop.Resources.SharedResource> Localizer

@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Coffee Premium</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg bg-white shadow-sm">
        <div class="container">

            <a class="navbar-brand fw-bold fs-2"
               asp-controller="Home"
               asp-action="Index">
                ☕ Coffee Premium
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">

                <!-- MENU -->
                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Index" && currentController == "Home" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index">
                            @Localizer["Home"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Store" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Store">
                            @Localizer["Store"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "About" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="About">
                            @Localizer["About"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentAction == "Contact" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Contact">
                            @Localizer["Contact"]
                        </a>
                    </li>

                </ul>

                <div class="d-flex align-items-center">

                    <!-- SEARCH -->
                    <form asp-controller="Home"
                          asp-action="Store"
                          method="get"
                          class="d-flex me-3">

                        <div class="input-group">

                            <input type="text"
                                   name="keyword"
                                   class="form-control search-box"
                                   value="@Context.Request.Query["keyword"]"
                                   placeholder="@Localizer["Search"]" />

                            <button class="btn btn-coffee" type="submit">
                                <i class="bi bi-search"></i>
                            </button>

                        </div>

                    </form>

                    <!-- Bộ lọc giá -->
                    <form asp-controller="Home"
                          asp-action="Index"
                          method="get"
                          class="me-3">

                        <select name="price"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="">Lọc</option>

                            <option value="1">
                                Dưới 50.000đ
                            </option>

                            <option value="2">
                                50.000đ - 100.000đ
                            </option>

                            <option value="3">
                                Trên 100.000đ
                            </option>

                        </select>

                    </form>

                    <!-- LOGIN -->
                    @if (Context.Session.GetString("UserName") == null)
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-dark me-3">
                            <i class="bi bi-person fs-5"></i>
                        </a>
                    }
                    else
                    {
                        <div class="dropdown me-3">

                            <a class="text-dark text-decoration-none dropdown-toggle"
                               href="#"
                               data-bs-toggle="dropdown">
                                👋 @Context.Session.GetString("UserName")
                            </a>

                            <ul class="dropdown-menu">

                                @if (Context.Session.GetString("Role") == "Admin")
                                {
                                    <li><a class="dropdown-item" asp-controller="AdminProduct" asp-action="Index">👑 Bảng điều khiển Admin</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminProduct" asp-action="Index">☕ Quản lý sản phẩm</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminOrder" asp-action="Index">📦 Quản lý đơn hàng</a></li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Cart"
                                           asp-action="Index">
                                            <i class="bi bi-cart"></i>
                                            Giỏ hàng của tôi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Order"
                                           asp-action="History">
                                            <i class="bi bi-bag-check"></i>
                                            Lịch sử mua hàng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }

                                @if (Context.Session.GetString("Role") == "Customer")
                                {
                                    <li class="dropdown-header text-center">

                                        <i class="bi bi-person-circle fs-1 text-secondary"></i>

                                        <div class="fw-bold mt-2">
                                            @Context.Session.GetString("UserName")
                                        </div>

                                        <small class="text-muted">
                                            Khách hàng
                                        </small>

                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>

                                        <span class="dropdown-item-text">

                                            <i class="bi bi-geo-alt"></i>

                                            @Context.Session.GetString("Address")

                                        </span>

                                    </li>

                                    <li>

                                        <span class="dropdown-item-text">

                                            <i class="bi bi-telephone"></i>

                                            @Context.Session.GetString("Phone")

                                        </span>

                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Cart"
                                           asp-action="Index">

                                            <i class="bi bi-cart"></i>

                                            Giỏ hàng của tôi

                                        </a>

                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Order"
                                           asp-action="History">

                                            <i class="bi bi-bag-check"></i>

                                            Lịch sử mua hàng

                                        </a>

                                    </li>

                                    <li><hr class="dropdown-divider"></li>
                                }

                                @if (Context.Session.GetString("Role") == "Employee")
                                {
                                    <li class="dropdown-header text-center">

                                        <i class="bi bi-person-circle fs-1 text-secondary"></i>

                                        <div class="fw-bold mt-2">
                                            @Context.Session.GetString("UserName")
                                        </div>

                                        <small class="text-muted">
                                            Nhân viên
                                        </small>

                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>

                                        <span class="dropdown-item-text">

                                            <i class="bi bi-geo-alt"></i>

                                            @Context.Session.GetString("Address")

                                        </span>

                                    </li>

                                    <li>

                                        <span class="dropdown-item-text">

                                            <i class="bi bi-telephone"></i>

                                            @Context.Session.GetString("Phone")

                                        </span>

                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Cart"
                                           asp-action="Index">

                                            <i class="bi bi-cart"></i>

                                            Giỏ hàng của tôi

                                        </a>

                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Order"
                                           asp-action="History">

                                            <i class="bi bi-bag-check"></i>

                                            Lịch sử mua hàng

                                        </a>

                                    </li>

                                    <li><a class="dropdown-item" asp-controller="AdminProduct" asp-action="Index">☕ Quản lý sản phẩm</a></li>

                                    <li><hr class="dropdown-divider"></li>
                                }

                                
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Account"
                                       asp-action="Logout">
                                        🚪 @Localizer["Logout"]
                                    </a>
                                </li>

                            </ul>

                        </div>
                    }

                    @if (Context.Session.GetString("UserName") != null)
                    {
                        <!-- ORDER HISTORY ICON -->
                        <a asp-controller="Order"
                           asp-action="History"
                           class="text-dark position-relative me-3"
                           title="Lịch sử đơn hàng của tôi">
                            <i class="bi bi-bag-check fs-5"></i>
                        </a>
                    }

                    <!-- CART -->
                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="text-dark position-relative"
                       title="Giỏ hàng của tôi">
                        <i class="bi bi-cart fs-5"></i>
                    </a>
                </div>

            </div>

        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer bg-dark text-white py-4">

        <div class="container text-center">

            <h5>Coffee Premium</h5>

            <p>Địa chỉ: TP. Hồ Chí Minh</p>

            <p>Hotline: 0938282070</p>

            <p>Email: coffeeshop@gmail.com</p>

            <!-- CÁC ICON MẠNG XÃ HỘI ĐÃ BỌC LINK -->
            <div class="mt-3">

                <!-- Facebook -->
                <a href="https://www.facebook.com/share/1Bo6cvF69s/?mibextid=wwXIfr" target="_blank" class="text-white me-3 text-decoration-none">
                    <i class="bi bi-facebook fs-4"></i>
                </a>

                <!-- Instagram -->
                <a href="https://www.instagram.com/khoadang_163?igsh=aHA1ZmcxbXo2czNr&utm_source=qr" target="_blank" class="text-white me-3 text-decoration-none">
                    <i class="bi bi-instagram fs-4"></i>
                </a>

                <!-- YouTube -->
                <a href="https://www.youtube.com/@@CozyOutdoorJazz" target="_blank" class="text-white me-3 text-decoration-none">
                    <i class="bi bi-youtube fs-4"></i>
                </a>

                <!-- TikTok -->
                <a href="https://www.tiktok.com/@@toilabin25?_r=1&_t=ZS-98rlhu3m7jV" target="_blank" class="text-white text-decoration-none">
                    <i class="bi bi-tiktok fs-4"></i>
                </a>

            </div>

            <hr>

            <p class="mb-0">
                © 2026 Coffee Shop. All Rights Reserved.
            </p>

        </div>

    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>