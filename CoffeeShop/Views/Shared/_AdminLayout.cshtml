@using Microsoft.AspNetCore.Http
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var userName = Context.Session.GetString("UserName") ?? "Admin";
    var role = Context.Session.GetString("Role") ?? "Quản trị";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Coffee Shop Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>

    <div class="admin-wrapper">

        <!-- Sidebar -->
        <aside class="admin-sidebar">

            <div class="sidebar-header">
                <img src="~/images/logo.png" alt="Coffee Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/924/924514.png'" />
                <div class="sidebar-brand">Coffee Admin</div>
            </div>

            <div class="sidebar-menu">

                <div class="menu-label">Quản lý hệ thống</div>

                <a asp-controller="AdminProduct" asp-action="Index" class="nav-link-admin @(currentController == "AdminProduct" ? "active" : "")">
                    <i class="bi bi-cup-hot-fill"></i>
                    <span>Quản lý sản phẩm</span>
                </a>

                <a asp-controller="AdminOrder" asp-action="Index" class="nav-link-admin @(currentController == "AdminOrder" ? "active" : "")">
                    <i class="bi bi-bag-check-fill"></i>
                    <span>Quản lý đơn hàng</span>
                </a>

                <a asp-controller="Contact" asp-action="Index" class="nav-link-admin @(currentController == "Contact" ? "active" : "")">
                    <i class="bi bi-bag-check-fill"></i>
                    <span>Hổ trợ khách hàng</span>
                </a>

                @if (role == "Admin")
                {
                    <div class="menu-label mt-3">Quản lý tài khoản</div>

                    <a asp-controller="EmployeeManagement" asp-action="Index" class="nav-link-admin @(currentController == "EmployeeManagement" ? "active" : "")">
                        <i class="bi bi-person-badge-fill"></i>
                        <span>Quản lý nhân viên</span>
                    </a>

                    <a asp-controller="AdminCustomer" asp-action="Index" class="nav-link-admin @(currentController == "AdminCustomer" ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Quản lý khách hàng</span>
                    </a>
                }

                <div class="menu-label mt-3">Liên kết nhanh</div>

                <a asp-controller="Home" asp-action="Index" class="nav-link-admin">
                    <i class="bi bi-globe"></i>
                    <span>Xem trang cửa hàng</span>
                </a>

                <a asp-controller="Report"
                       asp-action="Index">

                    <i class="bi bi-bar-chart-fill"></i>
                    Báo cáo doanh thu

                </a>
            </div>

            <div class="sidebar-footer">
                <a asp-controller="Account" asp-action="Logout" class="nav-link-admin text-danger">
                    <i class="bi bi-box-arrow-right text-danger"></i>
                    <span>Đăng xuất hệ thống</span>
                </a>
            </div>

        </aside>

        <!-- Main Content Area -->
        <div class="admin-main">

            <!-- Navbar Header -->
            <header class="admin-navbar">
                <div class="nav-title">
                    <h4>@ViewData["Title"]</h4>
                </div>

                <div class="nav-user-area">
                    <div class="user-badge">
                        <div class="user-avatar">
                            @userName.Substring(0, 1).ToUpper()
                        </div>
                        <div class="user-info">
                            <span class="user-name">@userName</span>
                            <span class="user-role">@role</span>
                        </div>
                    </div>

                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                </div>
            </header>

            <!-- Main Content Container -->
            <main class="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-success-custom">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @RenderBody()
            </main>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>