@{
    ViewData["Title"] = "Liên hệ";
}
<script>

    const branches = [

    {
        name:"Chi nhánh Quận 1",
        address:"📍123 Nguyễn Huệ, Quận 1",
        phone:"☎ 0938 282 070",
        time:"🕒 07:00 - 22:00",
        image:"/uploads/store1.jpg"
    },

    {
        name:"Chi nhánh Bình Thạnh",
        address:"📍88 Điện Biên Phủ",
        phone:"☎ 0908 888 888",
        time:"🕒 07:00 - 22:00",
        image:"/uploads/store2.jpg"
    },

    {
        name:"Chi nhánh Thủ Đức",
        address:"📍25 Phạm Trần Kim Ngân",
        phone:"☎ 0907 777 777",
        time:"🕒 07:00 - 22:00",
        image:"/uploads/store3.jpg"
    }

    ];

    function changeBranch(index) {

        index = parseInt(index);

        document.getElementById("branchImg").src = branches[index].image;
        document.getElementById("branchName").innerHTML = branches[index].name;
        document.getElementById("branchAddress").innerHTML = branches[index].address;
        document.getElementById("branchPhone").innerHTML = branches[index].phone;
        document.getElementById("branchTime").innerHTML = branches[index].time;

    }

</script>
<!-- HERO -->
<section class="contact-header">

    <div class="overlay">

        <div class="container text-center">

            <h1>Liên Hệ Với Chúng Tôi</h1>

            <p>
                Coffee House luôn sẵn sàng lắng nghe và hỗ trợ bạn.
            </p>

        </div>

    </div>

</section>

<!-- CONTACT -->

<section class="container py-5">

    <div class="row g-4">

        <!-- FORM -->

        <div class="col-lg-7">

            <div class="contact-card">

                <h3 class="mb-4">

                    Gửi Tin Nhắn

                </h3>

                <form>

                    <div class="row">

                        <div class="col-md-6">

                            <input class="form-control mb-3"
                                   placeholder="Họ và tên">

                        </div>

                        <div class="col-md-6">

                            <input class="form-control mb-3"
                                   placeholder="Email">

                        </div>

                    </div>

                    <input class="form-control mb-3"
                           placeholder="Số điện thoại">

                    <textarea rows="6"
                              class="form-control mb-4"
                              placeholder="Nội dung cần hỗ trợ"></textarea>

                    <button class="btn btn-coffee">

                        Gửi Liên Hệ

                    </button>

                </form>

            </div>

        </div>

        <!-- INFO -->

        <div class="col-lg-5">

            <div class="contact-info">

                <h3 class="mb-4">

                    Thông Tin Hỗ Trợ

                </h3>

                <p>

                    📍 123 Nguyễn Huệ, Quận 1, TP.HCM

                </p>

                <p>

                    ☎ 0938 282 070

                </p>

                <p>

                    ✉ coffeeshop@gmail.com

                </p>

                <p>

                    🕒 07:00 - 22:00

                </p>

                <p>

                    🌐 Facebook: Coffee House

                </p>

                <hr>

                <h5>

                    Theo dõi chúng tôi

                </h5>

                <div class="social">

                    <i class="bi bi-facebook"></i>

                    <i class="bi bi-instagram"></i>

                    <i class="bi bi-youtube"></i>

                    <i class="bi bi-tiktok"></i>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- MAP -->

<section class="container mb-5">

    <h2 class="text-center fw-bold mb-4">

        🏪 Hệ Thống Chi Nhánh

    </h2>

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <select class="form-select form-select-lg mb-4"
                    onchange="changeBranch(this.value)">

                <option value="0">
                    Quận 1
                </option>

                <option value="1">
                    Bình Thạnh
                </option>

                <option value="2">
                    Thủ Đức
                </option>

            </select>

        </div>

    </div>

    <div class="branch-card">

        <img id="branchImg"
             src="~/uploads/store1.jpg"
             class="branch-photo"
             alt="Chi nhánh Coffee House">

        <div class="branch-info">

            <h3 id="branchName">
                Chi nhánh Quận 1
            </h3>

            <p id="branchAddress">
                📍123 Nguyễn Huệ, Quận 1
            </p>

            <p id="branchPhone">
                ☎ 0938 282 070
            </p>

            <p id="branchTime">
                🕒 07:00 - 22:00
            </p>

        </div>

    </div>

</section>

<!-- FAQ -->

<section class="container mb-5">

    <h2 class="text-center mb-5">

        Câu Hỏi Thường Gặp

    </h2>

    <div class="accordion" id="faq">

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#f1">

                    Coffee House có giao hàng không?

                </button>

            </h2>

            <div id="f1"
                 class="accordion-collapse collapse show"
                 data-bs-parent="#faq">

                <div class="accordion-body">

                    Có. Chúng tôi hỗ trợ giao hàng toàn quốc.

                </div>

            </div>

        </div>

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#f2">

                    Cửa hàng mở cửa khi nào?

                </button>

            </h2>

            <div id="f2"
                 class="accordion-collapse collapse"
                 data-bs-parent="#faq">

                <div class="accordion-body">

                    Từ 07:00 đến 22:00 mỗi ngày.

                </div>

            </div>

        </div>

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#f3">

                    Có thanh toán online không?

                </button>

            </h2>

            <div id="f3"
                 class="accordion-collapse collapse"
                 data-bs-parent="#faq">

                <div class="accordion-body">

                    Có. Hỗ trợ VNPay, MoMo và chuyển khoản.

                </div>

            </div>

        </div>

    </div>

</section>
