@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container mt-5">

    <h1 class="text-center mb-4">☕ Giới thiệu Coffee Shop</h1>

    <div class="row">

        <div class="col-md-6">

            <img src="~/images/about.jpg"
                 class="img-fluid rounded shadow" />

        </div>

        <div class="col-md-6">

            <h3>Về chúng tôi</h3>

            <p>
                Coffee Shop là cửa hàng chuyên cung cấp các loại cà phê
                nguyên chất, cà phê rang xay và các sản phẩm pha chế
                chất lượng cao.
            </p>

            <p>
                Chúng tôi mong muốn mang đến trải nghiệm thưởng thức cà phê
                tốt nhất cho mọi khách hàng.
            </p>

            <ul>
                <li>✔ Cà phê nguyên chất</li>
                <li>✔ Giao hàng toàn quốc</li>
                <li>✔ Giá tốt</li>
                <li>✔ Hỗ trợ 24/7</li>
            </ul>

        </div>

    </div>

</div>