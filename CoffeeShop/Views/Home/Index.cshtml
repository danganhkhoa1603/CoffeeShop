@inject Microsoft.Extensions.Localization.IStringLocalizer<CoffeeShop.Resources.SharedResource> Localizer
@model IEnumerable<CoffeeShop.Models.Product>

<!-- HERO -->
<section class="hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6 hero-text">

                <span class="hero-tag">
                    ☕ PREMIUM COFFEE - CI/CD
                </span>

                <h1>
                    @Localizer["PremiumCoffee"]
                </h1>

                <p>
                    @Localizer["EnjoyCoffee"]
                </p>

                <div class="mt-4">

                    <a href="#products" class="btn btn-coffee btn-lg me-3">
                        @Localizer["BuyNow"]
                    </a>

                    <a asp-controller="Home"
                           asp-action="Store"
                           class="btn btn-outline-light btn-lg">
                        @Localizer["Store"]
                    </a>

                </div>

            </div>

            <div class="col-lg-6 text-center">

                <img src="~/uploads/CoffeeShop.jpg"
                     class="hero-image"
                     alt="Coffee Shop" />

            </div>

        </div>

    </div>

</section>

<!-- GIỚI THIỆU -->
<section class="container py-5">

    <div class="row g-4">

        <div class="col-lg-4">

            <div class="feature-card">

                <i class="bi bi-cup-hot-fill"></i>

                <h4>Cà phê nguyên chất</h4>

                <p>
                    Hạt Arabica và Robusta được tuyển chọn,
                    rang xay mỗi ngày để giữ hương vị tự nhiên.
                </p>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="feature-card">

                <i class="bi bi-shop"></i>

                <h4>Không gian hiện đại</h4>

                <p>
                    Thiết kế ấm cúng, phù hợp học tập,
                    làm việc và gặp gỡ bạn bè.
                </p>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="feature-card">

                <i class="bi bi-truck"></i>

                <h4>Giao hàng nhanh</h4>

                <p>
                    Đặt hàng trực tuyến,
                    giao tận nơi trong thời gian ngắn nhất.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- DANH SÁCH SẢN PHẨM -->
<section id="products" class="container py-5">

    <h2 class="text-center fw-bold mb-5">
        @Localizer["FeaturedProducts"]
    </h2>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card product-card">

                    <img src="~/uploads/@item.Image"
                         class="product-image"
                         alt="@item.ProductName" />

                    <div class="card-body">

                        <h4>@item.ProductName</h4>

                        <p>@item.Description</p>

                        <h5 class="text-danger mb-3">
                            @item.Price.ToString("N0") VNĐ
                        </h5>

                        <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@item.ProductId"
                               class="btn btn-coffee w-100">

                            @Localizer["ViewDetails"]

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>