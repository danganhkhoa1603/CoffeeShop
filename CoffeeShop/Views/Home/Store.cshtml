@model IEnumerable<CoffeeShop.Models.Product>

@{
    ViewData["Title"] = "Cửa hàng";
}

<div class="container py-5">

    <section class="store-title mb-5">

        <div class="container text-center">

            <span class="store-tag">
                COFFEE BEANS COLLECTION
            </span>

            <h1>
                Cửa Hàng Cà Phê Nguyên Liệu
            </h1>

            <p>
                Khám phá các dòng hạt cà phê, cà phê rang xay và nguyên liệu pha chế
                được tuyển chọn từ những vùng nguyên liệu chất lượng cao.
            </p>

        </div>

    </section>

    <div class="row">

        @if (!Model.Any())
        {
            <div class="col-12 text-center">
                <h4>Hiện chưa có sản phẩm.</h4>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card product-card h-100">

                        <img src="~/uploads/@item.Image"
                             class="product-image"
                             alt="@item.ProductName" />

                        <div class="card-body text-center">

                            <h4>@item.ProductName</h4>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <h5 class="text-danger mb-3">
                                @item.Price.ToString("N0") VNĐ
                            </h5>

                            <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@item.ProductId"
                                   class="btn btn-coffee w-100">

                                Xem chi tiết

                            </a>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>