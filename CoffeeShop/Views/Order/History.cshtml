@model List<CoffeeShop.Models.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng của tôi";
}

<style>
    .btn-fix {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        white-space: nowrap !important;
        width: auto !important;
        height: auto !important;
        line-height: 1.5 !important;
    }

    .table td, .table th {
        vertical-align: middle;
    }
</style>

<div class="container py-5">
    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-2"></i>
                <span class="fw-semibold">@ViewBag.Success</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Lịch sử đơn hàng của tôi
            </h3>
            <p class="text-muted small mb-0">Theo dõi trạng thái và xem chi tiết các đơn hàng bạn đã đặt</p>
        </div>
        <a asp-controller="Home" asp-action="Store" class="btn btn-outline-primary rounded-pill px-4 py-2 btn-fix">
            <i class="bi bi-plus-circle me-1"></i> Đặt thêm món mới
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card shadow-sm border-0 rounded-4 p-5 text-center bg-white">
            <div class="py-4">
                <i class="bi bi-bag-x fs-1 text-muted opacity-50 d-block mb-3" style="font-size: 4rem !important;"></i>
                <h5 class="fw-bold text-dark mb-2">Bạn chưa có đơn hàng nào</h5>
                <p class="text-muted mb-4">Hãy khám phá thực đơn cà phê thơm ngon và chọn cho mình thức uống yêu thích nhé!</p>
                <a asp-controller="Home" asp-action="Store" class="btn btn-primary rounded-pill px-5 py-2 btn-fix">
                    <i class="bi bi-cup-hot me-1"></i> Khám phá menu ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Phương thức</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool isPending = item.Status == "Chờ xác nhận";
                            bool isCompleted = item.Status == "Hoàn thành" || item.Status == "Đã hoàn thành";
                            bool isQRPayment = item.Note != null && item.Note.Contains("QR");

                            <tr>
                                <td class="ps-4">
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId" class="fw-bold text-primary text-decoration-none fs-6">
                                        #@item.OrderId
                                    </a>
                                </td>
                                <td>
                                    <div class="text-dark small fw-semibold">@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@item.OrderDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <strong class="text-danger fs-6">@item.TotalMoney.ToString("N0") VNĐ</strong>
                                </td>
                                <td>
                                    @if (item.Status == "Chờ xác nhận")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill small">
                                            <i class="bi bi-clock me-1"></i> Chờ xác nhận
                                        </span>
                                    }
                                    else if (item.Status == "Đã xác nhận")
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill small">
                                            <i class="bi bi-check2 me-1"></i> Đã xác nhận
                                        </span>
                                    }
                                    else if (item.Status == "Đang giao" || item.Status == "Đang pha chế")
                                    {
                                        <span class="badge bg-primary px-3 py-2 rounded-pill small">
                                            <i class="bi bi-truck me-1"></i> Đang giao
                                        </span>
                                    }
                                    else if (isCompleted)
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill small">
                                            <i class="bi bi-check-circle-fill me-1"></i> Đã hoàn thành
                                        </span>
                                    }
                                    else if (item.Status == "Đã hủy")
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill small">
                                            <i class="bi bi-x-circle-fill me-1"></i> Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill small">
                                            @item.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (isQRPayment)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border px-2 py-1 rounded-pill small">
                                            <i class="bi bi-qr-code me-1"></i> QR ACB
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                                            <i class="bi bi-cash me-1"></i> COD
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1 align-items-center justify-content-end">

                                        <!-- Nút mở Modal Đánh Giá -->
                                        @if (isCompleted)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-warning text-dark rounded-pill px-2 py-1 btn-fix fw-semibold"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#reviewModal-@item.OrderId"
                                                    title="Đánh giá sản phẩm">
                                                <i class="bi bi-star-fill me-1"></i> Đánh giá
                                            </button>
                                        }

                                        <!-- QR Payment Button -->
                                        @if (isPending && isQRPayment)
                                        {
                                            <a asp-controller="Checkout" asp-action="PaymentQR" asp-route-id="@item.OrderId"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 btn-fix fw-semibold" title="Quét mã QR thanh toán">
                                                <i class="bi bi-qr-code-scan me-1"></i> Trả QR
                                            </a>
                                        }

                                        <!-- View Details Button -->
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId"
                                           class="btn btn-sm btn-outline-dark rounded-pill px-2 py-1 btn-fix" title="Xem chi tiết đơn hàng">
                                            <i class="bi bi-eye-fill me-1"></i> Chi tiết
                                        </a>

                                        <!-- Cancel Button -->
                                        @if (isPending)
                                        {
                                            <a asp-action="Cancel" asp-route-id="@item.OrderId"
                                               class="btn btn-sm btn-outline-warning rounded-pill px-2 py-1 btn-fix"
                                               onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng #@item.OrderId này không?');"
                                               title="Hủy đơn hàng">
                                                <i class="bi bi-x-circle me-1"></i> Hủy
                                            </a>
                                        }

                                        <!-- Delete History Button -->
                                        <form asp-action="DeleteHistory" asp-route-id="@item.OrderId" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn hàng #@item.OrderId khỏi lịch sử?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 btn-fix" title="Xóa lịch sử">
                                                <i class="bi bi-trash-fill me-1"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- CÁC MODAL ĐÁNH GIÁ ĐƯỢC ĐẶT Ở NGOÀI BẢNG CỦA TABLE CẢNH BÁO BỊ NHẤP NHÁY -->
        @foreach (var item in Model)
        {
            bool isCompleted = item.Status == "Hoàn thành" || item.Status == "Đã hoàn thành";
            if (isCompleted)
            {
                <div class="modal fade" id="reviewModal-@item.OrderId" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content rounded-4 border-0 shadow">
                            <form asp-controller="Review" asp-action="Create" method="post">
                                <input type="hidden" name="OrderId" value="@item.OrderId" />

                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold">
                                        <i class="bi bi-star text-warning me-2"></i>Đánh giá đơn hàng #@item.OrderId
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>

                                <div class="modal-body py-3">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Chất lượng món & dịch vụ:</label>
                                        <select name="Rating" class="form-select rounded-3" required>
                                            <option value="5">⭐⭐⭐⭐⭐ (Tuyệt vời)</option>
                                            <option value="4">⭐⭐⭐⭐ (Rất tốt)</option>
                                            <option value="3">⭐⭐⭐ (Bình thường)</option>
                                            <option value="2">⭐⭐ (Chưa hài lòng)</option>
                                            <option value="1">⭐ (Rất tệ)</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Nhận xét của bạn:</label>
                                        <textarea name="Comment" class="form-control rounded-3" rows="3" placeholder="Hãy chia sẻ trải nghiệm về đồ uống và thời gian giao hàng..." required></textarea>
                                    </div>
                                </div>

                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">Gửi đánh giá</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>