@model List<CoffeeShop.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

@if (ViewBag.Success != null)
{
    <div class="container mt-3">
        <div class="alert alert-success">
            @ViewBag.Success
        </div>
    </div>
}

<div class="container mt-5">

    <h2 class="mb-4">📦 Đơn hàng của tôi</h2>

    <table class="table table-bordered table-hover">

        <thead class="table-dark">

            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Chi tiết</th>
                <th>Thao tác</th>
            </tr>

        </thead>

        <tbody>

            @if (Model.Count == 0)
            {
                <tr>

                    <td colspan="6" class="text-center">

                        Bạn chưa có đơn hàng nào.

                    </td>

                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>#@item.OrderId</td>

                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>

                        <td class="text-danger fw-bold">

                            @item.TotalMoney.ToString("N0") VNĐ

                        </td>

                        <td>

                            @if (item.Status == "Chờ xác nhận")
                            {
                                <span class="badge bg-warning text-dark">
                                    @item.Status
                                </span>
                            }
                            else if (item.Status == "Đang pha chế")
                            {
                                <span class="badge bg-primary">
                                    @item.Status
                                </span>
                            }
                            else if (item.Status == "Hoàn thành")
                            {
                                <span class="badge bg-success">
                                    @item.Status
                                </span>
                            }
                            else if (item.Status == "Đã hủy")
                            {
                                <span class="badge bg-danger">
                                    @item.Status
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @item.Status
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-controller="Order"
                               asp-action="Details"
                               asp-route-id="@item.OrderId"
                               class="btn btn-info btn-sm">

                                🔍 Xem

                            </a>

                        </td>

                        <td>

                            @if (item.Status == "Chờ xác nhận")
                            {
                                <a asp-action="Cancel"
                                   asp-route-id="@item.OrderId"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">

                                    ❌ Hủy

                                </a>
                            }
                            else
                            {
                                <span class="text-muted">

                                    Không thể hủy

                                </span>
                            }

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>