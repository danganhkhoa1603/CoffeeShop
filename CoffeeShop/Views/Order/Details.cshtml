@model CoffeeShop.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Chi tiết Đơn hàng #{Model.Order.OrderId}";
    bool isPending = Model.Order.Status == "Chờ xác nhận";
    bool isQRPayment = Model.Order.Note != null && Model.Order.Note.Contains("QR");
}

<!-- CSS Fix lỗi vỡ nút -->
<style>
    .btn-fix {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        white-space: nowrap !important;
        width: auto !important;
        height: auto !important;
    }
</style>

<div class="container py-5">
    <!-- Thanh thao tác trên -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <a asp-action="History" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-fix">
            <i class="bi bi-arrow-left me-1"></i> Quay lại lịch sử đơn hàng
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-dark text-white p-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="mb-1 fw-bold">
                    <i class="bi bi-receipt me-2"></i>Chi tiết đơn hàng #@Model.Order.OrderId
                </h4>
                <small class="text-white-50">Ngày đặt: @Model.Order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
            </div>
            <div>
                @if (Model.Order.Status == "Chờ xác nhận")
                {
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-clock me-1"></i> Chờ xác nhận
                    </span>
                }
                else if (Model.Order.Status == "Đã xác nhận")
                {
                    <span class="badge bg-info text-dark px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-check2 me-1"></i> Đã xác nhận
                    </span>
                }
                else if (Model.Order.Status == "Đang giao" || Model.Order.Status == "Đang pha chế")
                {
                    <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-truck me-1"></i> Đang giao
                    </span>
                }
                else if (Model.Order.Status == "Đã hoàn thành" || Model.Order.Status == "Hoàn thành")
                {
                    <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-check-circle-fill me-1"></i> Đã hoàn thành
                    </span>
                }
                else
                {
                    <span class="badge bg-danger px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-x-circle-fill me-1"></i> Đã hủy
                    </span>
                }
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Thông tin khách hàng -->
            <div class="row g-3 mb-4 p-3 bg-light rounded-3">
                <div class="col-md-4">
                    <span class="text-muted small d-block">Người nhận:</span>
                    <strong class="text-dark">@Model.Order.CustomerName</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Số điện thoại:</span>
                    <strong class="text-dark">@Model.Order.Phone</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Địa chỉ giao hàng:</span>
                    <span class="text-dark">@Model.Order.Address</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Order.Note))
                {
                    <div class="col-12 border-top pt-2 mt-2">
                        <span class="text-muted small d-block">Ghi chú & Phương thức thanh toán:</span>
                        <span class="text-dark">@Model.Order.Note</span>
                    </div>
                }
            </div>

            <!-- Khung thanh toán QR -->
            @if (isPending || isQRPayment)
            {
                <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center p-3 rounded-3 mb-4 gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary text-white p-3 rounded-circle fs-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-qr-code"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1 text-primary">Thanh toán chuyển khoản qua mã QR VietQR (ACB)</h6>
                            <p class="mb-0 small text-muted">
                                Quét mã QR bằng App Ngân hàng hoặc Ví điện tử: ACB - STK: <strong>16010991</strong> (DANG ANH KHOA)
                            </p>
                        </div>
                    </div>
                    <a asp-controller="Checkout" asp-action="PaymentQR" asp-route-id="@Model.Order.OrderId" class="btn btn-primary rounded-pill px-4 py-2 btn-fix fw-bold">
                        <i class="bi bi-qr-code-scan me-1"></i> Mở mã QR thanh toán
                    </a>
                </div>
            }

            <!-- Bảng sản phẩm -->
            <div class="table-responsive mb-4">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ảnh</th>
                            <th>Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            var subtotal = item.Price * item.Quantity;
                            <tr>
                                <td width="80">
                                    <img src="~/uploads/@(item.Product?.Image ?? "default.jpg")"
                                         width="60" height="60"
                                         class="rounded object-fit-cover shadow-xs"
                                         onerror="this.src='https://cdn-icons-png.flaticon.com/512/924/924514.png'" />
                                </td>
                                <td>
                                    <strong class="text-dark">@(item.Product?.ProductName ?? "Sản phẩm")</strong>
                                </td>
                                <td class="text-center fw-bold">@($"x{item.Quantity}")</td>
                                <td class="text-end text-muted">@item.Price.ToString("N0") VNĐ</td>
                                <td class="text-end text-danger fw-bold">@subtotal.ToString("N0") VNĐ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tổng tiền -->
            <div class="d-flex justify-content-end align-items-center pt-3 border-top">
                <div class="text-end">
                    <span class="text-muted fs-6 me-2">Tổng tiền thanh toán:</span>
                    <span class="fs-4 fw-bold text-danger">@Model.Order.TotalMoney.ToString("N0") VNĐ</span>
                </div>
            </div>
        </div>
    </div>
</div>