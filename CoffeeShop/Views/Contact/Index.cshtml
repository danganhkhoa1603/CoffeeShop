@model IEnumerable<Coffee.Models.Contact>

@{
    ViewData["Title"] = "Quản lý liên hệ";
    // Chỉ định Layout trang Admin
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <h3 class="fw-bold mb-4">Danh sách yêu cầu hỗ trợ</h3>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" width="60">#</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Nội dung</th>
                            <th>Ngày gửi</th>
                            <th>Trạng thái</th>
                            <th class="text-center" width="160">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@stt</td>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td style="max-width: 300px; white-space: normal;">
                                    @item.Message
                                </td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.IsRead)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                            Đã xem
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-2">
                                            Chưa xem
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!item.IsRead)
                                    {
                                        <!-- Nút Xác nhận -->
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-2 me-1" title="Xác nhận đã xem">
                                                <i class="bi bi-check-lg"></i> Xác nhận
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <!-- Nút Hủy xác nhận (Hiển thị khi đã xem) -->
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-warning text-dark rounded-2 me-1" title="Hủy trạng thái đã xem">
                                                <i class="bi bi-x-circle"></i> Hủy
                                            </button>
                                        </form>
                                    }
                                        
                                    <!-- Nút Xóa (Nếu có) -->
                                    <a href="#" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                                
                            </tr>
                            stt++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>