@{
    ViewData["Title"] = "Đăng nhập Admin";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="login-page">

    <div class="login-card">

        <!-- Left Hero Side -->
        <div class="left-side">

            <div class="brand-header">
                <img src="~/images/logo.png" alt="Coffee House Logo" class="logo-image" onerror="this.src='https://cdn-icons-png.flaticon.com/512/924/924514.png'" />
                <h2>Coffee Admin</h2>
            </div>

            <div class="hero-content">
                <div class="hero-title">Hệ thống Quản lý Coffee House</div>
                <div class="hero-subtitle">Bảng điều khiển dành riêng cho Quản trị viên hệ thống để theo dõi doanh thu, sản phẩm và đơn hàng.</div>
                
                <div class="hero-features">
                    <div class="feature-tag">
                        <i class="bi bi-shield-check"></i>
                        <span>Bảo mật hệ thống cao cấp</span>
                    </div>
                    <div class="feature-tag">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Thống kê doanh thu thời gian thực</span>
                    </div>
                    <div class="feature-tag">
                        <i class="bi bi-box-seam"></i>
                        <span>Quản lý kho hàng & nhân sự</span>
                    </div>
                </div>
            </div>

            <div class="hero-footer">
                © 2026 Coffee House. Admin Control System.
            </div>

        </div>

        <!-- Right Form Side -->
        <div class="right-side">

            <!-- Role Selector Tabs -->
            <div class="role-tabs">
                <a asp-controller="Account" asp-action="Login" class="role-tab">
                    <i class="bi bi-person-heart"></i> Khách hàng
                </a>
                <a asp-controller="EmployeeLogin" asp-action="Login" class="role-tab">
                    <i class="bi bi-person-badge"></i> Nhân viên
                </a>
                <a asp-controller="AdminLogin" asp-action="Login" class="role-tab active">
                    <i class="bi bi-shield-lock"></i> Quản trị viên
                </a>
            </div>

            <div class="form-header">
                <h3>Cổng Đăng nhập Admin</h3>
                <p>Nhập số điện thoại và mật khẩu quản trị viên</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-custom">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form method="post" asp-controller="AdminLogin" asp-action="Login">

                <div class="input-group-modern">
                    <label>Số điện thoại Admin</label>
                    <div class="input-wrapper">
                        <input type="text" name="phone" class="input-control" placeholder="Nhập SĐT tài khoản admin" required />
                        <i class="bi bi-person-badge input-icon"></i>
                    </div>
                </div>

                <div class="input-group-modern">
                    <label>Mật khẩu</label>
                    <div class="input-wrapper">
                        <input type="password" name="password" class="input-control" placeholder="Nhập mật khẩu admin" required />
                        <i class="bi bi-lock input-icon"></i>
                    </div>
                </div>

                <button type="submit" class="btn-login">
                    <span>Vào trang Quản trị</span>
                    <i class="bi bi-arrow-right-short fs-4"></i>
                </button>

            </form>

            <div class="form-footer">
                Quay lại trang chủ?
                <a asp-controller="Home" asp-action="Index">Về trang chủ CoffeeHouse</a>
            </div>

        </div>

    </div>

</div>