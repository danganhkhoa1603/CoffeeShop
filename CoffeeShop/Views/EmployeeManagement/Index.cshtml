@model List<CoffeeShop.Models.User>

@{
    Layout = "_AdminLayout";
}

<div class="container mt-5">

    <h2>👨‍💼 Quản lý nhân viên</h2>

    <a asp-action="Create"
       class="btn btn-success mb-3">

        + Thêm nhân viên

    </a>

    <table class="table table-bordered">

        <thead class="table-dark">

            <tr>
                <th>Họ tên</th>
                <th>SĐT</th>
                <th>Địa chỉ</th>
                <th></th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.FullName</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.UserId"
                           class="btn btn-warning">

                            Sửa

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.UserId"
                           class="btn btn-danger">

                            Xóa

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>