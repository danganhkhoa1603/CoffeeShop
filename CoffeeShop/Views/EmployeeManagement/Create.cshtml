@model CoffeeShop.Models.User
@{
    ViewData["Title"] = "Thêm Nhân viên mới";
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách nhân viên
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="admin-card">
            <h5 class="card-title-custom mb-4">
                <i class="bi bi-person-plus-fill text-success"></i> Thêm Nhân viên mới
            </h5>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-3">
                    <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Họ và tên nhân viên <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên đầy đủ" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại đăng nhập" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu cho nhân viên" required />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ nhân viên (không bắt buộc)" />
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary-coffee px-4">
                        <i class="bi bi-check-lg me-1"></i> Lưu Nhân viên
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>