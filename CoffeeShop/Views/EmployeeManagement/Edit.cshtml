@model CoffeeShop.Models.User
@{
    ViewData["Title"] = "Sửa thông tin Nhân viên";
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách nhân viên
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="admin-card">
            <h5 class="card-title-custom mb-4">
                <i class="bi bi-pencil-square text-warning"></i> Sửa thông tin Nhân viên #@Model.UserId
            </h5>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Họ và tên nhân viên <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên đầy đủ" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại đăng nhập" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mật khẩu mới</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Để trống nếu không muốn đổi mật khẩu" />
                    <small class="text-muted">Chỉ nhập nếu bạn muốn đổi mật khẩu mới cho nhân viên này.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ nhân viên" />
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary-coffee px-4">
                        <i class="bi bi-check-lg me-1"></i> Cập nhật thông tin
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>