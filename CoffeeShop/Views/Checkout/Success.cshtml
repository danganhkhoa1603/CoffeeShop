@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 rounded-4 p-5 max-w-600 mx-auto bg-white" style="max-width: 600px;">
        <div class="mb-4">
            <div class="rounded-circle bg-success-subtle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                <i class="bi bi-check-circle-fill text-success fs-1"></i>
            </div>
        </div>

        <h2 class="fw-bold text-dark mb-2">🎉 Đặt hàng thành công!</h2>
        <p class="text-muted mb-4">Cảm ơn bạn đã lựa chọn Coffee Premium. Đơn hàng của bạn đã được ghi nhận và đang trong quá trình chuẩn bị.</p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
            <a asp-controller="Order" asp-action="History" class="btn btn-primary-coffee rounded-pill px-4 py-2">
                <i class="bi bi-bag-check me-1"></i> Xem lịch sử đơn hàng
            </a>
            <a asp-controller="Home" asp-action="Store" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                <i class="bi bi-cup-hot me-1"></i> Tiếp tục mua hàng
            </a>
        </div>
    </div>
</div>