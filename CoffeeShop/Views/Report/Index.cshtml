@model CoffeeShop.ViewModels.RevenueReportViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Báo cáo Doanh thu & Đơn hàng";
    Layout = "_AdminLayout";
    var currentPeriod = Model.Period;
}

<!-- Page Header & Filter Tabs -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-graph-up-arrow text-primary me-2"></i>Báo cáo Doanh thu & Đơn hàng
        </h4>
        <p class="text-muted small mb-0">@Model.PeriodTitle</p>
    </div>

    <!-- Period Filter Buttons & Year Selector -->
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="filter-tabs">
            <a asp-action="Index" asp-route-period="week" class="filter-btn @(currentPeriod == "week" ? "active" : "")">
                <i class="bi bi-calendar-week me-1"></i>Theo tuần (7 ngày)
            </a>
            <a asp-action="Index" asp-route-period="month" class="filter-btn @(currentPeriod == "month" ? "active" : "")">
                <i class="bi bi-calendar-month me-1"></i>1 tháng (30 ngày)
            </a>
            <a asp-action="Index" asp-route-period="6months" class="filter-btn @(currentPeriod == "6months" ? "active" : "")">
                <i class="bi bi-calendar-range me-1"></i>6 tháng
            </a>
            <a asp-action="Index" asp-route-period="year" asp-route-year="@Model.SelectedYear" class="filter-btn @(currentPeriod == "year" ? "active" : "")">
                <i class="bi bi-calendar3 me-1"></i>1 năm (12 tháng)
            </a>
        </div>

        @if (currentPeriod == "year")
        {
            <form method="get" asp-action="Index" class="d-inline-flex align-items-center gap-1 ms-1">
                <input type="hidden" name="period" value="year" />
                <select name="year" class="form-select form-select-sm border-secondary-subtle" style="width: 110px;" onchange="this.form.submit()">
                    @foreach (var y in Model.AvailableYears)
                    {
                        <option value="@y" selected="@(y == Model.SelectedYear)">Năm @y</option>
                    }
                </select>
            </form>
        }
    </div>
</div>

<!-- Stat Cards Grid -->
<div class="stat-grid mb-4">
    <!-- Total Revenue -->
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="bi bi-cash-stack"></i>
        </div>
        <div class="stat-details">
            <h5>Tổng doanh thu hoàn thành</h5>
            <div class="stat-value text-success">@Model.TotalRevenue.ToString("N0") <small class="fs-6 text-muted">VNĐ</small></div>
        </div>
    </div>

    <!-- Total Orders -->
    <div class="stat-card">
        <div class="stat-icon coffee">
            <i class="bi bi-bag-check-fill"></i>
        </div>
        <div class="stat-details">
            <h5>Đơn hàng hoàn thành</h5>
            <div class="stat-value text-dark">
                @Model.TotalOrders <small class="fs-6 text-muted">/ @Model.TotalAllOrders tổng đơn</small>
            </div>
        </div>
    </div>

    <!-- Average Order Value -->
    <div class="stat-card">
        <div class="stat-icon amber">
            <i class="bi bi-receipt-cutoff"></i>
        </div>
        <div class="stat-details">
            <h5>Giá trị TB / Đơn hàng</h5>
            <div class="stat-value text-warning" style="color: #d97706 !important;">
                @Model.AverageOrderValue.ToString("N0") <small class="fs-6 text-muted">VNĐ</small>
            </div>
        </div>
    </div>

    <!-- Total Customers -->
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="stat-details">
            <h5>Tổng số khách hàng</h5>
            <div class="stat-value text-primary">@Model.TotalCustomers <small class="fs-6 text-muted">thành viên</small></div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Column Chart: Revenue & Orders by Period -->
    <div class="col-lg-8">
        <div class="admin-card h-100 mb-0">
            <div class="card-header-custom">
                <h5 class="card-title-custom">
                    <i class="bi bi-bar-chart-fill text-primary"></i> Biểu đồ cột: Doanh thu & Tổng đơn hàng (@Model.PeriodTitle)
                </h5>
                <span class="badge bg-light text-dark border px-2 py-1 small">
                    <i class="bi bi-info-circle me-1 text-primary"></i> Đơn vị: VNĐ & Số đơn
                </span>
            </div>

            <div style="position: relative; height: 360px; width: 100%;">
                <canvas id="periodColumnChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Pie Chart 1: Order Status Distribution -->
    <div class="col-lg-4">
        <div class="admin-card h-100 mb-0 d-flex flex-column">
            <div class="card-header-custom">
                <h5 class="card-title-custom">
                    <i class="bi bi-pie-chart-fill text-warning"></i> Biểu đồ tròn: Trạng thái đơn hàng
                </h5>
            </div>

            <div class="flex-grow-1 d-flex align-items-center justify-content-center" style="position: relative; min-height: 260px; max-height: 290px;">
                @if (Model.OrderStatusCounts.Any(c => c > 0))
                {
                    <canvas id="orderStatusPieChart"></canvas>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-pie-chart fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <span>Chưa có dữ liệu đơn hàng trong khoảng thời gian này</span>
                    </div>
                }
            </div>

            <!-- Legend summary list -->
            @if (Model.OrderStatusCounts.Any(c => c > 0))
            {
                <div class="mt-3 pt-3 border-top">
                    <div class="row g-2 small">
                        @for (int i = 0; i < Model.OrderStatusLabels.Count; i++)
                        {
                            <div class="col-6 d-flex justify-content-between">
                                <span class="text-truncate text-muted me-1">• @Model.OrderStatusLabels[i]:</span>
                                <strong>@Model.OrderStatusCounts[i] (@Model.OrderStatusPercentages[i]%)</strong>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Row 2: Category Revenue Breakdown & Detail Table -->
<div class="row g-4 mb-4">
    <!-- Pie Chart 2: Category Revenue Share -->
    <div class="col-lg-4">
        <div class="admin-card h-100 mb-0 d-flex flex-column">
            <div class="card-header-custom">
                <h5 class="card-title-custom">
                    <i class="bi bi-pie-chart-fill text-success"></i> Biểu đồ tròn: Doanh thu theo danh mục
                </h5>
            </div>

            <div class="flex-grow-1 d-flex align-items-center justify-content-center" style="position: relative; min-height: 260px; max-height: 290px;">
                @if (Model.CategoryRevenue.Any(r => r > 0))
                {
                    <canvas id="categoryPieChart"></canvas>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-pie-chart fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <span>Chưa có dữ liệu doanh thu danh mục trong khoảng thời gian này</span>
                    </div>
                }
            </div>

            <!-- Category summary list -->
            @if (Model.CategoryRevenue.Any(r => r > 0))
            {
                <div class="mt-3 pt-3 border-top">
                    <div class="row g-2 small">
                        @for (int i = 0; i < Model.CategoryNames.Count; i++)
                        {
                            <div class="col-12 d-flex justify-content-between">
                                <span class="text-truncate text-muted me-2">• @Model.CategoryNames[i]:</span>
                                <span class="text-nowrap">
                                    <strong>@Model.CategoryRevenue[i].ToString("N0") đ</strong>
                                    <span class="text-muted">(@Model.CategoryPercentages[i]%)</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Period Detail Table -->
    <div class="col-lg-8">
        <div class="admin-card h-100 mb-0">
            <div class="card-header-custom">
                <h5 class="card-title-custom">
                    <i class="bi bi-table text-primary"></i> Bảng số liệu chi tiết (@Model.PeriodTitle)
                </h5>
            </div>

            <div class="table-responsive table-scrollable">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Thời gian (@Model.PeriodUnitLabel)</th>
                            <th class="text-center">Số đơn hoàn thành</th>
                            <th class="text-end">Doanh thu (VNĐ)</th>
                            <th class="text-end">Doanh thu TB / Đơn</th>
                            <th class="text-center">Tỷ trọng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ReportDetails.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Không có dữ liệu trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.ReportDetails)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark">@item.Label</strong>
                                        @if (!string.IsNullOrEmpty(item.SubLabel))
                                        {
                                            <small class="text-muted ms-1">(@item.SubLabel)</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.OrderCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill fw-bold">
                                                <i class="bi bi-bag-check text-success me-1"></i>@item.OrderCount đơn
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0 đơn</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.Revenue > 0)
                                        {
                                            <strong class="text-success">@item.Revenue.ToString("N0") VNĐ</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0 VNĐ</span>
                                        }
                                    </td>
                                    <td class="text-end text-muted">
                                        @(item.AverageRevenuePerOrder > 0 ? item.AverageRevenuePerOrder.ToString("N0") + " VNĐ" : "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.PercentageOfTotal > 0)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border px-2 py-1 rounded-pill">
                                                @item.PercentageOfTotal%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0%</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold bg-light">
                            <td class="text-dark">Tổng cộng</td>
                            <td class="text-center text-primary">@Model.TotalOrders đơn</td>
                            <td class="text-end text-success">@Model.TotalRevenue.ToString("N0") VNĐ</td>
                            <td class="text-end text-muted">@(Model.AverageOrderValue > 0 ? Model.AverageOrderValue.ToString("N0") + " VNĐ" : "-")</td>
                            <td class="text-center">100%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Data from C# Model
            const chartLabels = @Html.Raw(JsonSerializer.Serialize(Model.ChartLabels));
            const revenueData = @Html.Raw(JsonSerializer.Serialize(Model.RevenueData));
            const ordersData = @Html.Raw(JsonSerializer.Serialize(Model.OrdersData));

            const statusLabels = @Html.Raw(JsonSerializer.Serialize(Model.OrderStatusLabels));
            const statusCounts = @Html.Raw(JsonSerializer.Serialize(Model.OrderStatusCounts));

            const categoryLabels = @Html.Raw(JsonSerializer.Serialize(Model.CategoryNames));
            const categoryRevenues = @Html.Raw(JsonSerializer.Serialize(Model.CategoryRevenue));

            // Theme Palette Colors
            const colorPrimary = '#6f4e37';       // Coffee Brown
            const colorAccent = '#d4a373';        // Gold/Amber
            const colorGreen = '#10b981';         // Emerald Green
            const colorBlue = '#3b82f6';          // Blue
            const colorPurple = '#8b5cf6';        // Purple
            const colorOrange = '#f97316';        // Orange
            const colorCyan = '#06b6d4';          // Cyan

            // Status colors helper
            const getStatusColor = (label) => {
                if (label.includes("hoàn thành")) return '#10b981';
                if (label.includes("Chờ") || label.includes("chờ")) return '#f59e0b';
                if (label.includes("xác nhận")) return '#3b82f6';
                if (label.includes("giao")) return '#8b5cf6';
                if (label.includes("hủy") || label.includes("Hủy")) return '#ef4444';
                return '#6b7280';
            };

            // ==========================================
            // 1. Biểu đồ Cột: Doanh thu & Tổng đơn hàng (Dual Axis Column Chart)
            // ==========================================
            const columnCtx = document.getElementById('periodColumnChart');
            if (columnCtx) {
                new Chart(columnCtx, {
                    type: 'bar',
                    data: {
                        labels: chartLabels,
                        datasets: [
                            {
                                label: 'Tổng doanh thu (VNĐ)',
                                data: revenueData,
                                backgroundColor: 'rgba(111, 78, 55, 0.85)',
                                hoverBackgroundColor: '#6f4e37',
                                borderColor: '#6f4e37',
                                borderWidth: 1,
                                borderRadius: 6,
                                yAxisID: 'yRevenue',
                                order: 2
                            },
                            {
                                label: 'Tổng đơn hàng (Số đơn)',
                                data: ordersData,
                                backgroundColor: 'rgba(212, 163, 115, 0.9)',
                                hoverBackgroundColor: '#d4a373',
                                borderColor: '#b88758',
                                borderWidth: 1,
                                borderRadius: 6,
                                yAxisID: 'yOrders',
                                order: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    font: { family: "'Plus Jakarta Sans', sans-serif", weight: '600', size: 12 },
                                    usePointStyle: true,
                                    padding: 15
                                }
                            },
                            tooltip: {
                                padding: 12,
                                boxPadding: 6,
                                titleFont: { size: 13, weight: '700' },
                                bodyFont: { size: 13 },
                                callbacks: {
                                    label: function (context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.datasetIndex === 0) {
                                            label += new Intl.NumberFormat('vi-VN').format(context.parsed.y) + ' VNĐ';
                                        } else {
                                            label += context.parsed.y + ' đơn';
                                        }
                                        return label;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: "'Plus Jakarta Sans', sans-serif", size: 11 } }
                            },
                            yRevenue: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Doanh thu (VNĐ)',
                                    font: { size: 11, weight: '600' }
                                },
                                ticks: {
                                    callback: function (value) {
                                        if (value >= 1000000) return (value / 1000000) + 'M';
                                        if (value >= 1000) return (value / 1000) + 'k';
                                        return value;
                                    },
                                    font: { size: 11 }
                                },
                                grid: { color: 'rgba(0, 0, 0, 0.05)' }
                            },
                            yOrders: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Số đơn hàng',
                                    font: { size: 11, weight: '600' }
                                },
                                ticks: {
                                    precision: 0,
                                    font: { size: 11 }
                                },
                                grid: { drawOnChartArea: false }
                            }
                        }
                    }
                });
            }

            // ==========================================
            // 2. Biểu đồ Tròn 1: Trạng thái đơn hàng (Doughnut Chart)
            // ==========================================
            const statusPieCtx = document.getElementById('orderStatusPieChart');
            if (statusPieCtx && statusCounts.length > 0) {
                const statusColors = statusLabels.map(label => getStatusColor(label));

                new Chart(statusPieCtx, {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusCounts,
                            backgroundColor: statusColors,
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    padding: 10,
                                    font: { family: "'Plus Jakarta Sans', sans-serif", size: 11, weight: '500' }
                                }
                            },
                            tooltip: {
                                padding: 10,
                                callbacks: {
                                    label: function (context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.chart._metasets[context.datasetIndex].total;
                                        const pct = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return ` ${label}: ${value} đơn (${pct}%)`;
                                    }
                                }
                            }
                        },
                        cutout: '60%'
                    }
                });
            }

            // ==========================================
            // 3. Biểu đồ Tròn 2: Tỷ trọng doanh thu theo danh mục (Pie Chart)
            // ==========================================
            const catPieCtx = document.getElementById('categoryPieChart');
            if (catPieCtx && categoryRevenues.length > 0) {
                const catColors = [colorPrimary, colorAccent, colorGreen, colorBlue, colorPurple, colorOrange, colorCyan];

                new Chart(catPieCtx, {
                    type: 'pie',
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            data: categoryRevenues,
                            backgroundColor: catColors.slice(0, categoryLabels.length),
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    padding: 10,
                                    font: { family: "'Plus Jakarta Sans', sans-serif", size: 11, weight: '500' }
                                }
                            },
                            tooltip: {
                                padding: 10,
                                callbacks: {
                                    label: function (context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.chart._metasets[context.datasetIndex].total;
                                        const pct = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return ` ${label}: ${new Intl.NumberFormat('vi-VN').format(value)} VNĐ (${pct}%)`;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}