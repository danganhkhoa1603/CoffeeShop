@model CoffeeShop.Models.Order
@{
    ViewData["Title"] = $"Chi tiết Đơn hàng #{Model.OrderId}";
    Layout = "_AdminLayout";
    var orderDetails = ViewBag.OrderDetails as List<CoffeeShop.Models.OrderDetail> ?? new List<CoffeeShop.Models.OrderDetail>();
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn hàng
    </a>
</div>

<div class="row g-4">
    <!-- Customer & Order Summary -->
    <div class="col-md-5">
        <div class="admin-card h-100 mb-0">
            <h5 class="card-title-custom mb-3">
                <i class="bi bi-person-lines-fill text-primary"></i> Thông tin Đơn hàng #@Model.OrderId
            </h5>

            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                    <span class="text-muted">Khách hàng:</span>
                    <strong class="text-dark">@Model.CustomerName</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                    <span class="text-muted">Số điện thoại:</span>
                    <span>@Model.Phone</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                    <span class="text-muted">Ngày đặt:</span>
                    <span>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                    <span class="text-muted">Trạng thái hiện tại:</span>
                    <div>
                        @if (Model.Status == "Chờ xác nhận")
                        {
                            <span class="badge-status badge-pending">Chờ xác nhận</span>
                        }
                        else if (Model.Status == "Đã xác nhận")
                        {
                            <span class="badge-status badge-confirmed">Đã xác nhận</span>
                        }
                        else if (Model.Status == "Đang giao")
                        {
                            <span class="badge-status badge-shipping">Đang giao</span>
                        }
                        else if (Model.Status == "Đã hoàn thành")
                        {
                            <span class="badge-status badge-completed">Đã hoàn thành</span>
                        }
                        else
                        {
                            <span class="badge-status badge-cancelled">Đã hủy</span>
                        }
                    </div>
                </li>
                <li class="list-group-item px-0 py-2">
                    <span class="text-muted d-block mb-1">Địa chỉ giao hàng:</span>
                    <div class="p-2 bg-light rounded text-dark">@Model.Address</div>
                </li>
                <li class="list-group-item px-0 py-2">
                    <span class="text-muted d-block mb-1">Ghi chú từ khách hàng:</span>
                    <div class="p-2 bg-light rounded text-muted">@(string.IsNullOrEmpty(Model.Note) ? "Không có ghi chú" : Model.Note)</div>
                </li>
            </ul>

            <!-- Form update status -->
            <form asp-action="UpdateStatus" method="post" class="card p-3 bg-light border-0 rounded-3">
                <input type="hidden" name="orderId" value="@Model.OrderId" />
                <label class="form-label fw-bold text-dark mb-2">Cập nhật trạng thái mới:</label>
                <div class="input-group">
                    <select name="status" class="form-select">
                        <option value="Chờ xác nhận" selected="@(Model.Status == "Chờ xác nhận")">Chờ xác nhận</option>
                        <option value="Đã xác nhận" selected="@(Model.Status == "Đã xác nhận")">Đã xác nhận</option>
                        <option value="Đang giao" selected="@(Model.Status == "Đang giao")">Đang giao</option>
                        <option value="Đã hoàn thành" selected="@(Model.Status == "Đã hoàn thành")">Đã hoàn thành</option>
                        <option value="Đã hủy" selected="@(Model.Status == "Đã hủy")">Đã hủy</option>
                    </select>
                    <button type="submit" class="btn btn-primary-coffee">
                        Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Order Items List -->
    <div class="col-md-7">
        <div class="admin-card h-100 mb-0">
            <h5 class="card-title-custom mb-3">
                <i class="bi bi-cup-hot text-danger"></i> Danh sách Sản phẩm
            </h5>

            <div class="table-responsive mb-3">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in orderDetails)
                        {
                            var subtotal = detail.Quantity * detail.Price;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="~/uploads/@(detail.Product?.Image ?? "default.jpg")"
                                             width="45" height="45" class="rounded object-fit-cover"
                                             onerror="this.src='https://cdn-icons-png.flaticon.com/512/924/924514.png'" />
                                        <div>
                                            <div class="fw-bold text-dark">@(detail.Product?.ProductName ?? "Sản phẩm")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@detail.Price.ToString("N0") đ</td>

                                <!-- ĐÃ SỬA LỖI TẠI DÒNG NÀY: Dùng @(detail.Quantity) -->
                                <td class="text-center">x@(detail.Quantity)</td>

                                <td class="text-end fw-bold text-dark">@subtotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 bg-white border rounded-3 text-end mt-auto">
                <span class="fs-6 text-muted me-3">Tổng cộng thanh toán:</span>
                <span class="fs-4 fw-bold text-danger">@Model.TotalMoney.ToString("N0") VNĐ</span>
            </div>
        </div>
    </div>
</div>